{
  "name": "@satya/shared-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SATYA-EoA data contracts. JSON Schema is the source of truth; TS and Pydantic are generated.",
  "exports": {
    ".": "./ts/src/index.ts",
    "./bundle.schema.json": "./ts/src/generated/bundle.schema.json",
    "./examples/*": "./examples/*"
  },
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
