{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.satya-eoa.invalid/v1/alert.schema.json",
  "title": "Alert",
  "description": "Alert with type + subtype (Portal spec §2.9). Institution-facing alerts are limited to missing_info, expired, unresolved.clarification_* and unresolved.compliance_window_*.",
  "type": "object",
  "additionalProperties": false,
  "required": ["alert_id", "type", "subtype", "severity", "audience_roles", "case_id", "application_id", "text_key", "created_at", "read"],
  "properties": {
    "alert_id": { "$ref": "common.schema.json#/$defs/AlertId" },
    "type": { "$ref": "#/$defs/AlertType" },
    "subtype": { "$ref": "#/$defs/AlertSubtype" },
    "severity": { "$ref": "common.schema.json#/$defs/Severity" },
    "audience_roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Role" } },
    "case_id": { "$ref": "common.schema.json#/$defs/CaseId" },
    "application_id": { "$ref": "common.schema.json#/$defs/ApplicationId" },
    "flag_id": { "$ref": "common.schema.json#/$defs/FlagId" },
    "doc_id": { "$ref": "common.schema.json#/$defs/DocId" },
    "label": { "$ref": "verification-label.schema.json" },
    "aph_clause": { "type": "string", "minLength": 1, "maxLength": 64 },
    "text_key": { "type": "string", "minLength": 1, "maxLength": 128 },
    "due_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "read": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "missing_info" } } }, "then": { "properties": { "subtype": { "enum": ["document_missing", "field_missing", "category_line_missing", "uploader_dsc_missing"] } } } },
    { "if": { "properties": { "type": { "const": "expired" } } }, "then": { "properties": { "subtype": { "enum": ["document_expired", "expiring_soon", "partial_oc_limit_reached", "signing_cert_expired"] } } } },
    { "if": { "properties": { "type": { "const": "pending_source" } } }, "then": { "properties": { "subtype": { "enum": ["source_pending_overdue", "source_unavailable", "trust_anchor_revalidation"] } } } },
    { "if": { "properties": { "type": { "const": "suspected_anomaly" } } }, "then": { "properties": { "subtype": { "enum": ["affidavit_diff", "signature_integrity", "signature_image_only", "stamp_chronology", "identity_graph", "yoy_discrepancy", "document_misclassified", "media_reuse"] } } } },
    { "if": { "properties": { "type": { "const": "unresolved" } } }, "then": { "properties": { "subtype": { "enum": ["flag_undisposed_overdue", "manual_task_overdue", "clarification_overdue", "compliance_window_expiring", "compliance_window_lapsed"] } } } },
    { "if": { "properties": { "type": { "const": "role" } } }, "then": { "properties": { "subtype": { "enum": ["case_assigned", "sitting_scheduled", "evc_scheduled", "hearing_scheduled", "selection_round_opened"] } } } }
  ],
  "x-subtypes": {
    "missing_info": ["document_missing", "field_missing", "category_line_missing", "uploader_dsc_missing"],
    "expired": ["document_expired", "expiring_soon", "partial_oc_limit_reached", "signing_cert_expired"],
    "pending_source": ["source_pending_overdue", "source_unavailable", "trust_anchor_revalidation"],
    "suspected_anomaly": ["affidavit_diff", "signature_integrity", "signature_image_only", "stamp_chronology", "identity_graph", "yoy_discrepancy", "document_misclassified", "media_reuse"],
    "unresolved": ["flag_undisposed_overdue", "manual_task_overdue", "clarification_overdue", "compliance_window_expiring", "compliance_window_lapsed"],
    "role": ["case_assigned", "sitting_scheduled", "evc_scheduled", "hearing_scheduled", "selection_round_opened"]
  },
  "$defs": {
    "AlertType": { "title": "AlertType", "type": "string", "enum": ["missing_info", "expired", "pending_source", "suspected_anomaly", "unresolved", "role"] },
    "AlertSubtype": {
      "title": "AlertSubtype",
      "type": "string",
      "enum": [
        "document_missing", "field_missing", "category_line_missing", "uploader_dsc_missing",
        "document_expired", "expiring_soon", "partial_oc_limit_reached", "signing_cert_expired",
        "source_pending_overdue", "source_unavailable", "trust_anchor_revalidation",
        "affidavit_diff", "signature_integrity", "signature_image_only", "stamp_chronology", "identity_graph", "yoy_discrepancy", "document_misclassified", "media_reuse",
        "flag_undisposed_overdue", "manual_task_overdue", "clarification_overdue", "compliance_window_expiring", "compliance_window_lapsed",
        "case_assigned", "sitting_scheduled", "evc_scheduled", "hearing_scheduled", "selection_round_opened"
      ]
    }
  }
}
