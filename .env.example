# SATYA-EoA local development environment.
# Copy with `make secrets` (generates random values for every CHANGE_ME). Never commit `.env`.
# Synthetic data only. No real names, IDs or personal data anywhere.

# ---- PostgreSQL (pgvector) ----
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# Least-privilege roles (decision: separate migration and runtime roles)
SATYA_DB_MIGRATOR_PASSWORD=CHANGE_ME
SATYA_DB_APP_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# ---- Valkey (Celery broker + result backend) ----
VALKEY_PASSWORD=CHANGE_ME

# ---- Keycloak ----
# Temporary bootstrap admin, random per machine. Never a default credential.
KC_BOOTSTRAP_ADMIN_USERNAME=kc-bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Shared password for the synthetic demo users (rb.southern.demo, auditor.demo, ...)
DEMO_USER_PASSWORD=CHANGE_ME
# OIDC client secrets (set into Keycloak by infra/scripts/keycloak-post-start.sh)
SATYA_WEB_CLIENT_SECRET=CHANGE_ME
SATYA_MOCK_PORTAL_CLIENT_SECRET=CHANGE_ME
PORTAL_INTEGRATION_CLIENT_SECRET=CHANGE_ME

# ---- Web apps (Auth.js session encryption) ----
SATYA_WEB_AUTH_SECRET=CHANGE_ME
SATYA_MOCK_PORTAL_AUTH_SECRET=CHANGE_ME

# ---- Portal Integration API: HMAC signing of event bodies (Portal spec §2.2) ----
PORTAL_HMAC_KID=mock-portal-k1
PORTAL_HMAC_SECRET=CHANGE_ME

# ---- Gateway tokenisation key (Portal spec §2.6.1; gateway key in the demo) ----
SATYA_TOKENISATION_KEY=CHANGE_ME

# ---- Public hostnames (local HTTPS through Caddy, tls internal) ----
SATYA_WEB_ORIGIN=https://localhost
SATYA_PORTAL_ORIGIN=https://portal.localhost
SATYA_AUTH_ORIGIN=https://auth.localhost

# ---- API limits ----
SATYA_MAX_BODY_BYTES=1048576
# Per-IP window. The workbench server calls the API from one address for all of its users, so
# this must cover their combined traffic; each official still has the per-user quota (300/minute).
SATYA_RATE_LIMIT=600/minute
